AWS_S3_BUCKET_NAME=your-existing-snapshot-bucket
AWS_REGION=us-east-1
S3_PREFIX=
# Optional: select an existing profile from ~/.aws/config and ~/.aws/credentials.
# AWS_PROFILE=default
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
TEXT_EMBEDDING_DIMENSIONS=768
CHROMA_COLLECTION=rag_object_collection
# Absolute path recommended. Default: batch-enrichment/data
# ENRICHMENT_DATA_DIR=/absolute/path/to/enrichment-data
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=16
